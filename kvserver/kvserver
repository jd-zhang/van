#!/usr/bin/env python3.11
"""
Start the VanDB KV server.

    ./kvserver [-c kvserver.toml]

Python 3.11 or newer is required: the configuration is read with tomllib.
"""
import argparse
import os
import sys

# The SWIG extension (_kvstore.so) and the generated kvstore.py live next
# to this script, so make sure they are importable no matter where the
# server is started from.
HERE = os.path.dirname(os.path.abspath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

from server.app import create_app  # noqa: E402
from server.config import Config  # noqa: E402
from server.kv_client import KVStore  # noqa: E402


def main(argv=None):
    parser = argparse.ArgumentParser(description="VanDB KV REST server")
    parser.add_argument(
        "-c",
        "--config",
        default=os.path.join(HERE, "kvserver.toml"),
        help="configuration file (default: ./kvserver.toml)",
    )
    args = parser.parse_args(argv)

    config = Config(args.config)
    print("starting kvserver: %r" % (config,), file=sys.stderr)

    with KVStore(config) as db:
        app = create_app(db)
        app.run(
            host=config.host,
            port=config.port,
            threaded=True,
        )

    return 0


if __name__ == "__main__":
    sys.exit(main())
